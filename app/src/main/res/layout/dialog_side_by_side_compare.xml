<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="bioKT Drug-Likeness Comparison"
            android:textColor="#0D47A1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="Side-by-Side Property &amp; ADMET Comparison"
            android:textColor="#666666"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Drug 1 Column -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvCompName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drug A"
                        android:textColor="#1976D2"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivCompImage1"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Drug A structure" />

                    <TextView
                        android:id="@+id/tvCompFormula1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Formula"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCompMw1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="MW: 0.0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCompLogP1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LogP: 0.0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCompHbd1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HBD: 0 | HBA: 0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCompTpsa1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TPSA: 0.0 Å²"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCompLipinski1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_badge_pass"
                        android:text="Lipinski: PASS"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCompVeber1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_badge_pass"
                        android:text="Veber: PASS"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="ADMET Profile:"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCompOral1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip_safe"
                        android:text="Oral: Good"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvCompBbb1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip_safe"
                        android:text="BBB: Moderate"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvCompHerg1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip_safe"
                        android:text="hERG: Safe"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Drug 2 Column -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvCompName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drug B"
                        android:textColor="#00897B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivCompImage2"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Drug B structure" />

                    <TextView
                        android:id="@+id/tvCompFormula2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Formula"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCompMw2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="MW: 0.0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCompLogP2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LogP: 0.0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCompHbd2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HBD: 0 | HBA: 0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCompTpsa2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TPSA: 0.0 Å²"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCompLipinski2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_badge_pass"
                        android:text="Lipinski: PASS"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCompVeber2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_badge_pass"
                        android:text="Veber: PASS"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="ADMET Profile:"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCompOral2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip_safe"
                        android:text="Oral: Good"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvCompBbb2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip_safe"
                        android:text="BBB: Moderate"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvCompHerg2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip_safe"
                        android:text="hERG: Safe"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseComparison"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Close Comparison"
            app:cornerRadius="10dp" />
    </LinearLayout>
</ScrollView>
